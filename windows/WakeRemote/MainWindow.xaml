<Window x:Class="WakeRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wake Remote"
        Width="460" Height="720" MinWidth="390" MinHeight="620"
        Background="#0C0C0C"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#262626" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Click="Back_Click"
                        Style="{StaticResource NavButton}" HorizontalAlignment="Left">&#8249; Back</Button>
                <TextBlock Grid.Column="1" Text="Wake Remote" Foreground="#26A7E1"
                           FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Button x:Name="SettingsButton" Grid.Column="2" Click="Settings_Click"
                        Style="{StaticResource NavButton}" HorizontalAlignment="Right">Settings</Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <!-- Fluid rather than a fixed 380px block inside a resizable window. -->
            <Grid x:Name="Body" MaxWidth="420" Margin="24,24"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="Assets/apex-shield.png" Width="18" Height="18" Opacity=".55" Margin="0,0,8,0"/>
            <TextBlock Text="Apex Tech Labs" Foreground="#929292" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
